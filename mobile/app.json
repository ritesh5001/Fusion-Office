{
  "expo": {
    "name": "Fusion Office",
    "slug": "fusion-office",
    "scheme": "fusionoffice",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0c11",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.nextgenfusion.fusionoffice",
      "infoPlist": {
        "NSCameraUsageDescription": "Fusion Office uses the camera to scan documents into PDFs. Photos stay on your device.",
        "NSPhotoLibraryUsageDescription": "Fusion Office opens photos you choose so you can turn them into PDFs or compress them. They stay on your device."
      }
    },
    "android": {
      "package": "in.nextgenfusion.fusionoffice",
      "adaptiveIcon": {
        "backgroundColor": "#0a0c11",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
