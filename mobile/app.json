            },
            {
              "mimeType": "application/x-zip-compressed"
            },
            {
              "mimeType": "application/epub+zip"
            }
          ]
        },
        {
          "action": "SEND_MULTIPLE",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "application/pdf"
            },
            {
              "mimeType": "image/*"
            }
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Fusion Office uses the camera to scan documents into PDFs. Photos stay on your device.",
          "photosPermission": "Fusion Office opens photos you choose so you can turn them into PDFs or compress them. They stay on your device.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#0a0c11"
        }
      ],
      "./plugins/with-release-signing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "nextgen-fusion",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "39cec647-e0e3-493b-8dcb-9bf9c1d76963"
      }
    }
  }
