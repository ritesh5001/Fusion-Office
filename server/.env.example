# Server port (the client proxies /api/* here)
PORT=4000

# Browser origins allowed to call this API (CORS + write-request origin check),
# comma-separated. localhost:3000 is always allowed outside production, and the
# origin of AUTH_URL is added automatically. `npm run storage:cors` uses the
# same list to configure the bucket.
# CLIENT_ORIGIN="https://fusionoffice.app,https://www.fusionoffice.app"

# ─── Everything below is OPTIONAL ───────────────────────────────────
# The PDF editor runs fully in the browser without any of these.
# Fill them in to enable sign-in + cloud save.

# PostgreSQL (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/fusion_office"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""
# Public URL of the site + /api/auth (the address users see, i.e. the client).
# Used for OAuth callback URLs. Required in production; optional locally.
# AUTH_URL="https://your-domain.com/api/auth"
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# S3 / Cloudflare R2
# For R2: S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com", S3_REGION="auto"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""