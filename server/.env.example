# Server port (Render sets PORT automatically)
PORT=4000

# Browser origins allowed to call this API (CORS + write-request origin check).
# The origin of AUTH_URL is added automatically; localhost:3000 outside production.
CLIENT_ORIGIN="https://fusionoffice.app,https://www.fusionoffice.app"

# PostgreSQL (Render Postgres "Internal Database URL")
DATABASE_URL="postgresql://user:password@localhost:5432/fusion_office"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""
# Public address of the SITE (the client service) + /api/auth.
# OAuth callback to register: <site>/api/auth/callback/github (or /google).
AUTH_URL="https://fusion-office.onrender.com/api/auth"
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# File storage for uploaded PDFs: a folder on the server's disk.
# On Render use the persistent disk mount, e.g. /var/data/files.
# Locally it defaults to ./.data/files.
STORAGE_DIR=""
# Largest upload accepted, in MB.
MAX_UPLOAD_MB=200
# Optional key for signing file links (defaults to AUTH_SECRET).
STORAGE_SIGNING_SECRET=""

# ── PDF tools that run on the server ──────────────────────────────
# Word/PowerPoint/Excel → PDF uses LibreOffice. Defaults to `soffice` on PATH
# (macOS: brew install --cask libreoffice). The Docker image sets it.
SOFFICE_PATH=""
# HTML → PDF uses headless Chrome/Chromium. Found automatically in the usual
# places; set it if yours lives elsewhere. The Docker image sets it.
CHROME_PATH=""
# Largest Office file accepted, in MB, and how many conversions run at once.
CONVERT_MAX_MB=50
CONVERT_CONCURRENCY=1
HTML_CONCURRENCY=2
# Requests per IP: conversions per 10 minutes, AI requests per hour.
CONVERT_RATE_LIMIT=40
AI_RATE_LIMIT=20

# AI tools (Summarize, Translate) run on Claude. Leave empty to turn them off.
# When sign-in is configured, only signed-in users can use them.
ANTHROPIC_API_KEY=""
# Optional: model override (default claude-opus-5) and the largest document, in characters.
AI_MODEL=""
AI_MAX_CHARS=400000
