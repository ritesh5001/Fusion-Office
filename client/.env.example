# URL of the backend (../server). /api/* is proxied there.
# On Render the blueprint sets SERVER_HOSTPORT (private network) instead.
SERVER_URL="http://localhost:4000"

# Largest file the editor will open, in MB.
NEXT_PUBLIC_MAX_FILE_MB=200

# Optional: call the API directly instead of through the /api proxy.
# Requires the server's CLIENT_ORIGIN to include this site, and both on the
# same parent domain (app.example.com + api.example.com) for cookies.
# NEXT_PUBLIC_API_URL="https://api.example.com"
